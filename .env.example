# ==============================================================================
# JobGuard AI - Environment Configuration Template
# ==============================================================================

# Node.js Express Backend Service
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# JWT Authentication
JWT_SECRET=jobguard_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRATION=24h

# MySQL 8.4 Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=jobguard_db
DB_CONNECTION_LIMIT=10

# Python FastAPI Machine Learning Service
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_PORT=8000

# Google Gemini API (Required for Contextual Forensic AI Reasoning)
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# CAPTCHA Configuration
CAPTCHA_SECRET=jobguard_captcha_hmac_secret_token_2026
CAPTCHA_EXPIRATION_SECONDS=300

# Operation Mode: auto | online | offline
JOBGUARD_MODE=auto

# Storage Directories
STORAGE_PATH=../storage
